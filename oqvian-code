#!/usr/bin/env bash
# OQVIAN CODE — Claude Code-style interactive CLI (like `claude`).
#
#   oqvian-code                       # interactive REPL
#   oqvian-code -p "hack localhost"   # one-shot (like claude -p)
#   oqvian-code --model oqvian:latest # start on a specific model
#
# Backend is the exact same harness as the web UI (dsh web host + Ollama +
# 11435 tool bridge), so terminal and browser behave identically.
set -u
ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PY_BIN="$ROOT/.venv/bin/python"; [ -x "$PY_BIN" ] || PY_BIN="$(command -v python3 || echo python3)"
exec "$PY_BIN" "$ROOT/scripts/oqvian-code.py" "$@"
